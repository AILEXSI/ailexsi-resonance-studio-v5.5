{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "types": ["vite/client"]
  },
  "include": ["src", "tests"],
  "exclude": [
    "tests/media/user-fixtures.test.ts",
    "tests/export/afe-parser.test.ts",
    "tests/export/afe-oracle.test.ts",
    "tests/v55/mediabunny-absent.test.ts",
    "tests/v55/identity.test.ts",
    "tests/export/afe-cache-abort.test.ts",
    "tests/export/afe-stream-plan.test.ts",
    "tests/export/afe-bframe.test.ts",
    "tests/export/afe-bframe-memory.test.ts",
    "tests/export/afe-bframe-pixels.test.ts",
    "tests/export/afe-bframe-hard.test.ts",
    "tests/export/afe-stall-watchdog.test.ts",
    "tests/export/afe-stall-nudge.test.ts",
    "tests/export/afe-07-recovery.test.ts",
    "tests/export/afe-08-transaction-end.test.ts",
    "tests/export/afe-09-counter-invariant.test.ts",
    "tests/export/afe-10-request-ownership.test.ts",
    "tests/export/afe-11-final-flush.test.ts",
    "tests/export/afe-12-decode-backpressure.test.ts",
    "tests/export/afe-13-backpressure-deadlock.test.ts",
    "tests/export/afe-14-packet-parity-window.test.ts",
    "tests/export/afe-15-exact-pts-tail-ownership.test.ts",
    "tests/export/afe-16-empty-pump-slice.test.ts"
  ]
}
